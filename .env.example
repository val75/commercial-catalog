# Copy to .env, which git ignores, and fill in your model server's address.
# It must be the OpenAI-compatible base path, which usually ends in /v1.
MODEL_BASE_URL=http://your-model-server:8080/v1

# Optional. Set these when the server asks for them.
# MODEL_API_KEY=your-server-key
# MODEL_NAME=the-server-model-name

# The review database (PostgreSQL). Create it with: createdb commercial_catalog
# Add user:password@ before the host if your Postgres asks for a password.
DATABASE_URL=postgresql+psycopg://localhost/commercial_catalog
# A separate database for the tests, which wipe it on every run. Without it, the database tests skip.
TEST_DATABASE_URL=postgresql+psycopg://localhost/commercial_catalog_test
# The folder where uploaded originals are kept, named by their SHA-256.
ORIGINALS_DIR=/path/to/originals
